flowchart TD
    Start([Start]) --> Check["Check rental availability"]
    Check --> Available{"Available?"}
    Available -- No --> Rechoose["Choose another date/device"]
    Available -- Yes --> Rental["Create rental order"]
    Rental --> Contract["Sign contract and pay rental fee"]
    Contract --> Handover["Staff prepares, collects deposit, hands over device"]
    Handover --> Return["Customer returns device"]
    Return --> Complete["Staff creates return report and completes rental"]
    Complete --> End([End])
