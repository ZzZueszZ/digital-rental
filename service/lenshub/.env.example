APP_JWT_SECRET=replace-with-strong-jwt-secret
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_ISSUER=zyna-ecommerce

APP_ACTIVATION_JWT_SECRET=replace-with-strong-activation-secret
APP_ACTIVATION_BASE_URL=http://localhost:8080/api/auth/activate
APP_ACTIVATION_TTL_HOURS=24
APP_MAIL_FROM=no-reply@zyna.dev
APP_PASSWORD_RESET_TTL_MINUTES=10

# Database
DB_URL=jdbc:postgresql://localhost:5433/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-email-address
MAIL_PASSWORD=replace-with-app-password

# VNPAY
PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
TMN_CODE=replace-with-vnpay-terminal-code
SECRET_KEY=replace-with-vnpay-secret-key
RETURN_URL=http://localhost:8080/api/payments/vnpay/return
VERSION=2.1.0
COMMAND=pay
ORDER_TYPE=other
