flowchart TD
    Start([Start]) --> Register["Register account"]
    Register --> Activate["Activate account by email"]
    Activate --> Login["Login"]
    Login --> Auth{"Authentication successful?"}
    Auth -- No --> Error["Show validation/authentication error"]
    Auth -- Yes --> Session["Issue access token and refresh token"]
    Error --> Retry["Retry corresponding step"]
    Retry --> Register
    Session --> End([End])
