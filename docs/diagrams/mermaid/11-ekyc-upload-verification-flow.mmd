%% LensHub eKYC upload and verification flow
%% User screen flow:
%% 1. Start KYC
%% 2. Upload/chup CCCD front
%% 3. Upload/chup CCCD back
%% 4. OCR preview extracts identity data and shows warnings
%% 5. Retake CCCD if data/image is wrong
%% 6. Capture selfie
%% 7. Record guided liveness video with face angles
%% 8. Review all data and submit
%% 9. Backend runs facematch, liveness, risk scoring
%% 10. Admin manually approves or rejects
%%
%% API flow:
%% POST /ekyc/initiate
%% POST /ekyc/upload-front
%% POST /ekyc/upload-back
%% POST /ekyc/ocr-preview
%% POST /ekyc/upload-selfie
%% POST /ekyc/upload-liveness-video
%% POST /ekyc/submit
%% GET  /ekyc/status
%% Admin:
%% GET /admin/ekyc/pending
%% PUT /admin/ekyc/{id}/approve
%% PUT /admin/ekyc/{id}/reject

flowchart TD
  A["User bat dau eKYC"] --> B["Backend tao KYC session CREATED"]
  B --> C["User upload/chup CCCD mat truoc"]
  C --> D["Backend luu anh front va tra imageUrl"]
  D --> E["User upload/chup CCCD mat sau"]
  E --> F["Backend luu anh back va tra imageUrl"]

  F --> G["Frontend goi OCR preview"]
  G --> H["POST /ekyc/ocr-preview"]
  H --> I["Backend goi provider OCR front/back"]
  I --> J["Normalize + merge du lieu CCCD"]
  J --> K["Validate field: so CCCD, ho ten, ngay sinh, dia chi, han CCCD, confidence"]
  K --> L["Luu OCR preview vao verification_results"]
  L --> M["Frontend hien thi thong tin extract + warnings"]

  M --> N{"User thay thong tin on?"}
  N -->|Khong| C
  N -->|Co| O["User chup selfie"]
  O --> P["Backend upload selfie va tra imageUrl"]

  P --> Q["User record guided liveness video: center, left, right, center"]
  Q --> R["Backend upload video va tra videoUrl"]

  R --> S["User review anh + thong tin OCR + video"]
  S --> T["Submit final KYC"]
  T --> U["POST /ekyc/submit"]

  U --> V["Backend luu artifacts: front, back, selfie, liveness video"]
  V --> W["Backend reuse OCR preview, khong goi lai OCR neu da co"]
  W --> X["Backend goi facematch selfie vs CCCD front"]
  X --> Y["Backend bat buoc goi liveness voi videoUrl"]
  Y --> Z["Risk scoring"]

  Z --> AA{"Risk level"}
  AA -->|Low| AB["PENDING_REVIEW + goi y approve"]
  AA -->|Medium| AC["PENDING_REVIEW"]
  AA -->|High| AD["PENDING_REVIEW + canh bao reject"]

  AB --> AE["Admin xem ho so"]
  AC --> AE
  AD --> AE

  AE --> AF["Admin kiem tra OCR, anh, facematch, liveness, risk reason"]
  AF --> AG{"Admin quyet dinh"}
  AG -->|Approve| AH["Session APPROVED, user.kycStatus VERIFIED"]
  AG -->|Reject| AI["Session REJECTED, user.kycStatus REJECTED"]
