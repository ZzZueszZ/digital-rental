APP_JWT_SECRET=replace-with-base64-or-long-random-secret
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_ISSUER=digital-rental

APP_ACTIVATION_JWT_SECRET=replace-with-long-random-activation-secret
APP_ACTIVATION_BASE_URL=http://localhost:8080/api/auth/activate
APP_ACTIVATION_TTL_HOURS=24
APP_MAIL_FROM=no-reply@digital-rental.local
APP_PASSWORD_RESET_TTL_MINUTES=10

# VNPay
PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
TMN_CODE=replace-with-vnpay-tmn-code
SECRET_KEY=replace-with-vnpay-hash-secret
RETURN_URL=http://localhost:3000/checkout/vnpay-return
VERSION=2.1.0
COMMAND=pay
ORDER_TYPE=other

# Database
DB_URL=jdbc:postgresql://localhost:5433/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-password

# Admin bootstrap accounts. Keep disabled after first bootstrap.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password
APP_BOOTSTRAP_ADMIN_FULL_NAME=Admin Digital Rental

APP_BOOTSTRAP_SUPER_ADMIN_EMAIL=super-admin@example.com
APP_BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-strong-super-admin-password
APP_BOOTSTRAP_SUPER_ADMIN_FULL_NAME=Super Admin

# FPT AI
FPT_KYC_API_KEY=replace-with-fpt-kyc-api-key
APP_KYC_PROVIDER=fpt

# SDK Server Identity Keys
APP_E2EE_ENABLED=true
SERVER_IDENTITY_PRIV_B64=replace-with-base64-pkcs8-private-key
SERVER_IDENTITY_PUB_B64=replace-with-base64-x509-public-key
