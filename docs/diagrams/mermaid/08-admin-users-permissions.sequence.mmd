sequenceDiagram
    actor Admin as Admin
    actor SuperAdmin as Super Admin
    participant FE as Frontend Webapp
    participant API as Backend API
    participant UserSvc as User Service
    participant RoleSvc as Role Service
    participant PermissionSvc as Permission Service
    participant Security as Spring Security
    participant DB as Database

    Note over Admin,DB: 10-11. Luồng quản lý người dùng và phân quyền

    opt Frontend điều hướng theo role
        Admin->>FE: Đăng nhập thành công
        FE->>FE: Đọc role từ user/token state
        alt ROLE_SUPER_ADMIN
            FE-->>SuperAdmin: Điều hướng /super-admin
        else ROLE_ADMIN
            FE-->>Admin: Điều hướng /admin
        else ROLE_STAFF
            FE-->>Admin: Điều hướng /staff
        else Customer
            FE-->>Admin: Điều hướng trang chủ
        end
    end

    opt Backend kiểm tra quyền bằng @PreAuthorize
        Admin->>FE: Gọi tính năng admin
        FE->>API: Request kèm Bearer token
        API->>Security: JwtAuthenticationFilter validate token
        Security->>DB: Load/verify user authorities nếu cần
        Security-->>API: Authentication + authorities
        API->>Security: @PreAuthorize kiểm tra authority
        alt Có quyền
            API-->>FE: Cho phép xử lý request
        else Không có quyền
            API-->>FE: 403 Forbidden
        end
    end

    opt Xem danh sách, tìm/lọc, xem chi tiết user
        Admin->>FE: Mở quản lý user
        FE->>API: GET /users?filters
        API->>UserSvc: @PreAuthorize USER_READ
        UserSvc->>DB: Query users with filters
        API-->>FE: ApiResponse(users)
        FE-->>Admin: Hiển thị danh sách

        Admin->>FE: Xem chi tiết user
        FE->>API: GET /users/{id}
        API->>UserSvc: Query user detail
        UserSvc->>DB: Load user + roles + profile
        API-->>FE: ApiResponse(user)
    end

    opt Tạo/sửa/khóa/mở khóa/reset/xóa/khôi phục user
        Admin->>FE: Thực hiện thao tác user
        alt Tạo user
            FE->>API: POST /users
            API->>UserSvc: @PreAuthorize USER_CREATE
            UserSvc->>DB: Insert user
        else Sửa user
            FE->>API: PUT /users/{id}
            API->>UserSvc: @PreAuthorize USER_UPDATE
            UserSvc->>DB: Update user
        else Khóa/mở khóa user
            FE->>API: PUT /users/{id}/lock hoặc /unlock
            API->>UserSvc: Update account status
            UserSvc->>DB: Persist status
        else Reset mật khẩu user
            FE->>API: PUT /users/{id}/reset-password
            API->>UserSvc: Generate/set new password hash
            UserSvc->>DB: Update password
        else Xóa mềm/khôi phục user
            FE->>API: DELETE /users/{id} hoặc PUT /users/{id}/restore
            API->>UserSvc: Soft delete/restore
            UserSvc->>DB: Persist status/deleted flag
        end
        API-->>FE: ApiResponse(result)
        FE-->>Admin: Cập nhật UI
    end

    opt Cập nhật profile/avatar cho user
        Admin->>FE: Sửa profile/avatar user
        FE->>API: PUT /users/{id}/profile hoặc POST /users/{id}/profile/avatar
        API->>UserSvc: @PreAuthorize USER_UPDATE
        UserSvc->>DB: Update profile/avatar URL
        API-->>FE: ApiResponse(profile)
    end

    opt Quản lý role và permission
        SuperAdmin->>FE: Mở role/permission management
        FE->>API: GET /roles + GET /permissions
        API->>RoleSvc: @PreAuthorize ROLE_READ
        API->>PermissionSvc: @PreAuthorize PERMISSION_READ
        RoleSvc->>DB: Query roles
        PermissionSvc->>DB: Query permissions
        API-->>FE: ApiResponse(role/permission lists)

        SuperAdmin->>FE: Tạo/sửa/xóa role hoặc permission
        FE->>API: POST/PUT/DELETE /roles hoặc /permissions
        API->>RoleSvc: ROLE_WRITE hoặc PERMISSION_WRITE
        RoleSvc->>DB: Persist role/permission changes
        API-->>FE: ApiResponse(result)

        SuperAdmin->>FE: Gán permission cho role
        FE->>API: POST /roles/{id}/permissions
        API->>RoleSvc: Validate permission ids
        RoleSvc->>DB: Update role_permissions
        API-->>FE: ApiResponse(role)
    end
