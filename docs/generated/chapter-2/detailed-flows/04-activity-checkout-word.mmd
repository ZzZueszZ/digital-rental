flowchart TD
    Start([Start]) --> Cart["Browse product, add cart, apply voucher"]
    Cart --> Checkout["Confirm address and create order"]
    Checkout --> Stock{"Stock available?"}
    Stock -- No --> Fail["Return checkout error"]
    Stock -- Yes --> Vnpay["Redirect to VNPay"]
    Vnpay --> Callback["Receive VNPay callback"]
    Callback --> Payment{"Payment valid?"}
    Payment -- No --> PayFail["Mark payment failed"]
    Payment -- Yes --> PayOk["Confirm order and payment"]
    PayOk --> End([End])
